"baby_feeding"><value>no</value></Data><Data name="building"><value>apartments</value></Data><Data name="denomination"><value>reformed</value></Data><Data name="description"><value>La Gran Lògia Simbòlica Espanyola (GLSE) és una de les principals Obediències maçòniques existents a Espanya. Pertany al conjunt d'obediències integrades a CLIPSAS, i es defineix com a Obediència mixta o igualitària, liberal i adogmàtica.</value></Data><Data name="description:es"><value>La Gran Logia Simbólica Española (GLSE) es una de las principales Obediencias masónicas existentes en España. Pertenece al conjunto de obediencias integradas en CLIPSAS, y se define como Obediencia mixta o igualitaria, liberal y adogmática.</value></Data><Data name="email"><value>glse@glse.org</value></Data><Data name="fax"><value>+34 932 681 889</value></Data><Data name="internet_access"><value>wired</value></Data><Data name="name"><value>Gran Logia Simbólica Española</value></Data><Data name="name:ca"><value>Gran Lògia Simbòlica Espanyola</value></Data><Data name="name:es"><value>Gran Lògia Simbòlica Espanyola</value></Data><Data name="phone"><value>+34 932 681 889</value></Data><Data name="religion"><value>unitarian_universalist</value></Data><Data name="website"><value>https://glse.org/</value></Data><Data name="wheelchair"><value>limited</value></Data><Data name="wikidata"><value>Q5802757</value></Data><Data name="wikipedia"><value>ca:Gran Lògia Simbòlica Espanyola</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>2.1850324,41.4308528</coordinates></Point></Placemark><Placemark><name>Mezquita de Guixar</name><ExtendedData><Data name="@id"><value>way/813739338</value></Data><Data name="name"><value>Mezquita de Guixar</value></Data><Data name="wheelchair"><value>yes</value></Data><Data name="religion"><value>muslim</value></Data><Data name="addr:city"><value>Vigo</value></Data><Data name="addr:housenumber"><value>88</value></Data><Data name="addr:street"