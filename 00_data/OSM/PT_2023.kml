27</value></Data><Data name="historic"><value>yes</value></Data><Data name="inscription"><value>ESTA ERMIDA FOI MANDADA ERIGIR / PELOS DESCENDENTES DO CONDE / D. VASCO DA GAMA PARA RECOLHER / A IMAGEM DE S. RAFAEL QUE O / GUIOU DA INDIA / RESTAURADA PELA CãMARA MUNICIPAL EM 1942.</value></Data><Data name="name"><value>Ermida de São Rafael</value></Data><Data name="ref"><value>IPA.00004327</value></Data><Data name="ref:ipa"><value>4327</value></Data><Data name="religion"><value>christian</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>-7.7954471,38.2049759</coordinates></Point></Placemark><Placemark><name>Igreja da Misericórdia</name><ExtendedData><Data name="@id"><value>way/646131268</value></Data><Data name="religion"><value>christian</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>church</value></Data><Data name="denomination"><value>catholic</value></Data><Data name="name"><value>Igreja da Misericórdia</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>-7.7166906,38.7715975</coordinates></Point></Placemark><Placemark><name>Igreja Paroquial de São Pedro</name><ExtendedData><Data name="@id"><value>way/646134688</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>church</value></Data><Data name="denomination"><value>catholic</value></Data><Data name="name"><value>Igreja Paroquial de São Pedro</value></Data><Data name="religion"><value>christian</value></Data><Data name="wikidata"><value>Q10300197</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>-7.7175031,38.7670539</coordinates></Point></Placemark><Placemark><name>Ermida de São Sebastião</name><ExtendedData><Data name="@id"><value>way/646438839</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Dat