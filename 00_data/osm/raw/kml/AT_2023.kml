coordinates>14.1151851,48.5610436</coordinates></Point></Placemark><Placemark><ExtendedData><Data name="@id"><value>way/1037295521</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Data><Data name="religion"><value>christian</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>13.2287437,48.2656543</coordinates></Point></Placemark><Placemark><name>Hubertuskapelle</name><description>„Erbaut 1992 – Hans Moik – Jagdrevier Schneeberg Eck“.</description><ExtendedData><Data name="@id"><value>way/1037296607</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Data><Data name="denomination"><value>roman_catholic</value></Data><Data name="description"><value>„Erbaut 1992 – Hans Moik – Jagdrevier Schneeberg Eck“.</value></Data><Data name="name"><value>Hubertuskapelle</value></Data><Data name="religion"><value>christian</value></Data><Data name="url"><value>https://zcrux.zwalk.at/hubertuskapelle-48-384022-15-223927/</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>15.2239469,48.3840702</coordinates></Point></Placemark><Placemark><name>Waldhofkapelle</name><description>Den Impuls zur Wiederbelebung der Waldhof-Kapelle gibt im Jahre 1998 Pfarrer i. R. Gerhard Anderle. Er ist von 1962 bis 1964 Kaplan in Pöggstall und weiß von Menschen, die einst die Kapelle aufgesucht haben, zu berichten.</description><ExtendedData><Data name="@id"><value>way/1037306407</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Data><Data name="denomination"><value>roman_catholic</value></Data><Data name="description"><value>Den Impuls zur Wiederbelebung der Waldhof-Kapelle gibt im Jahre 1998 Pfarrer i. R. Gerhard Anderle. Er ist von 1962 bis 1964 Kaplan in Pöggstall und weiß von Menschen, die einst die Kapelle aufgesucht haben, zu berichten.</value></Data><Data name="name"><value>Waldhofkapelle</value></Data><Data name="note"><value>Die Waldhof-Häuser, die noch in der ersten Hälfte des 20. Jahrhunderts bewohnt sind, sind inzwischen verschwunden. Der Waldhof gehört zu Gemeinde Kirchschlag und pfarrlich zu Martinsberg.</value></Data><Data name="religion"><value>christian</value></Data><Data name="url"><value>https://zcrux.zwalk.at/kapelle-48-359605-15-190535/</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>15.1905881,48.3596371</coordinates></Point></Placemark><Placemark><name>Filialkirche Lorenzenberg</name><ExtendedData><Data name="@id"><value>way/1037328182</value></Data><Data name="building"><value>yes</value></Data><Data name="religion"><value>christian</value></Data><Data name="name"><value>Filialkirche Lorenzenberg</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>14.4427447,46.9207062</coordinates></Point></Placemark><Placemark><ExtendedData><Data name="@id"><value>way/1037991729</value></Data><Data name="url"><value>https://zcrux.zwalk.at/bildstock-48-441931-15-205896/</value></Data><Data name="note"><value>Seit dem Jahre 1899 scheint das Haus Nr.3 auf, es wurde von Franz (geb. 1875) und Maria (geb. 1872) Wansch bewirtschaftet. Als Franz Wansch im Ersten Weltkrieg fort musste, legte legte seine Gattin Maria ein Gelübde ab, eine Kapelle zu errichten.</value></Data><Data name="inscription"><value>„Zur Erinnerung an die Kriegszeiten 1914-1918. Gewidmet von Franz und Maria Wansch.“</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Data><Data name="historic"><value>wayside_shrine</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>15.2058488,48.4419468</coordinates></Point></Placemark><Placemark><name>Hubertuskapelle</name><ExtendedData><Data name="@id"><value>way/1037991731</value></Data><Data name="building"><value>yes/shrine</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="denomination"><value>roman_catholic</value></Data><Data name="historic"><value>wayside_shrine</value></Data><Data name="name"><value>Hubertuskapelle</value></Data><Data name="religion"><value>christian</value></Data><Data name="url"><value>https://zcrux.zwalk.at/hubertuskapelle-48-425806-15-230845/</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>15.2309975,48.4257267</coordinates></Point></Placemark><Placemark><name>Hubertuskapelle</name><ExtendedData><Data name="@id"><value>way/1038026381</value></Data><Data name="building"><value>yes/shrine</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="denomination"><value>roman_catholic</value></Data><Data name="historic"><value>wayside_shrine</value></Data><Data name="name"><value>Hubertuskapelle</value></Data><Data name="religion"><value>christian</value></Data><Data name="url"><value>https://zcrux.zwalk.at/hubertuskapelle-48-619492-15-303268/</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>15.3035222,48.6194378</coordinates></Point></Placemark><Placemark><name>Waldkindergarten Aschau</name><ExtendedData><Data name="@id"><value>way/1038192314</value></Data><Data name="amenity"><value>kindergarten</value></Data><Data name="building"><value>yes</value></Data><Data name="name"><value>Waldkindergarten Aschau</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>11.8877632,47.2662968</coordinates></Point></Placemark><Placemark><description>Ortskapelle Grünz mit Glockenturm</description><ExtendedData><Data name="@id"><value>way/1038723567</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><v