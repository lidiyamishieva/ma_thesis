value>way/1040755129</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Data><Data name="denomination"><value>roman_catholic</value></Data><Data name="inscription"><value>1843</value></Data><Data name="note"><value>„Errichtet 1843 durch Herrn Paul Kitzler, Landwirt, Mühlenbesitzer und Mesner, zum Dank dafür, dass nach einem Blitzschlag zwar die Mühle niederbrannte, aber durch das Gebet der Sturm drehte und Wohn– und Wirtschaftsgebäude von den Flammen verschont blieb</value></Data><Data name="religion"><value>christian</value></Data><Data name="url"><value>https://zcrux.zwalk.at/kapelle-bei-der-kitzlermuehle-48-461444-15-023463/</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>15.0235006,48.4614432</coordinates></Point></Placemark><Placemark><name>Waldkapelle</name><ExtendedData><Data name="@id"><value>way/1040876643</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Data><Data name="denomination"><value>roman_catholic</value></Data><Data name="inscription"><value>„In dankbarer Erinnerung an Pater Petrus Pavlicek OFM Gründer des Rosenkranz-Sühnekreuzzuges um den Frieden in der Welt wurde diese Kapelle errichtet und am 8. Dezember 1985 geweiht.“</value></Data><Data name="name"><value>Waldkapelle</value></Data><Data name="religion"><value>christian</value></Data><Data name="url"><value>https://zcrux.zwalk.at/waldkapelle-48-736890-15-286320/</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>15.2863441,48.7368855</coordinates></Point></Placemark><Placemark><name>NÖ Landeskindergarten</name><ExtendedData><Data name="@id"><value>way/1041431445</value></Data><Data name="phone"><value>+43 2636 3331</value></Data><Data name="addr:city"><value>Puchberg am Schneeberg</value></Data><Data name="addr:housenumber"><value>3</value></Data><Data name="ad