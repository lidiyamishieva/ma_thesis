l"><value>https://zcrux.zwalk.at/friesenhofkapelle-48-552017-14-979357/</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>14.979348,48.5520193</coordinates></Point></Placemark><Placemark><name>Kapelle Maria Schnee</name><ExtendedData><Data name="@id"><value>way/359819871</value></Data><Data name="alt_name"><value>Kapelle Bonacker</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Data><Data name="denomination"><value>catholic</value></Data><Data name="heritage"><value>2</value></Data><Data name="heritage:operator"><value>bda</value></Data><Data name="historic"><value>heritage</value></Data><Data name="name"><value>Kapelle Maria Schnee</value></Data><Data name="ref:at:bda"><value>65748</value></Data><Data name="religion"><value>christian</value></Data><Data name="wikidata"><value>Q38071781</value></Data><Data name="wikimedia_commons"><value>Category:Kapelle 'Maria Schnee' in Laterns-Bonacker</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>9.7244877,47.2612783</coordinates></Point></Placemark><Placemark><ExtendedData><Data name="@id"><value>way/359850965</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Data><Data name="denomination"><value>roman_catholic</value></Data><Data name="note"><value>Im Jahre 1934 wird beinahe der ganze Ort durch eine riesige Brandkatastrophe vernichtet. Es werden 14 Wirtschaftsgebäude, 6 Kleinhäuser und die Kapelle zerstört.</value></Data><Data name="religion"><value>christian</value></Data><Data name="url"><value>https://zcrux.zwalk.at/kapelle-frauendorf-48-552941-14-967808/</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>14.9678047,48.552941</coordinates></Point></Placemark><Placemark><name>Pflegeheim der Stadt Stockerau</name><ExtendedData><Data name="@i