mination"><value>orthodox</value></Data><Data name="description:be"><value>Царква Святой Параскевы Пятніцы — першы мураваны хрысціянскі храм Вільні — паўстаў у 1345 г. на месцы паганскага капішча балцкага бога п’янства Рагуціса. Ініцыятаркай стала пабожная віцебская княжна Марыя Яраславаўна — жонка вялікага князя Альгерда.</value></Data><Data name="name"><value>Vilniaus Šv. kankinės Paraskevos cerkvė</value></Data><Data name="name:be"><value>Царква Святой Параскевы Пятніцы</value></Data><Data name="name:en"><value>St. Paraskeva Church</value></Data><Data name="name:lt"><value>Vilniaus Šv. kankinės Paraskevos cerkvė</value></Data><Data name="name:pl"><value>Cerkiew Piatnicka w Wilnie</value></Data><Data name="religion"><value>christian</value></Data><Data name="roof:colour"><value>#AEAD9B</value></Data><Data name="wheelchair"><value>no</value></Data><Data name="wikidata"><value>Q1960270</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>25.289342,54.6809438</coordinates></Point></Placemark><Placemark><name>VU Tarptautinių santykių ir politikos mokslų institutas</name><ExtendedData><Data name="@id"><value>way/60783713</value></Data><Data name="wikipedia"><value>lt:Vilniaus universiteto Tarptautinių santykių ir politikos mokslų institutas</value></Data><Data name="wikidata"><value>Q7931198</value></Data><Data name="wheelchair"><value>yes</value></Data><Data name="addr:city"><value>Vilnius</value></Data><Data name="addr:housenumber"><value>10</value></Data><Data name="addr:postcode"><value>01130</value></Data><Data name="addr:street"><value>Vokiečių g.</value></Data><Data name="amenity"><value>university</value></Data><Data name="building"><value>yes</value></Data><Data name="name"><value>VU Tarptautinių santykių ir politikos mokslų institutas</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>25.2841692,54.6784982</coordinates></Point></Placemark><Placemark><name>Šiaulių Š