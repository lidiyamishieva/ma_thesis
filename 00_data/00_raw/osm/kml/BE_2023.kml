menity"><value>kindergarten</value></Data><Data name="name"><value>École Saint-Victor</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>3.7853015,50.399396</coordinates></Point></Placemark><Placemark><name>Kapelle zur Heiligen Familie</name><ExtendedData><Data name="@id"><value>way/542567699</value></Data><Data name="addr:city"><value>Eupen</value></Data><Data name="addr:country"><value>BE</value></Data><Data name="addr:postcode"><value>4700</value></Data><Data name="addr:street"><value>Bellmerin</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Data><Data name="denomination"><value>catholic</value></Data><Data name="description:de"><value>Die Kapelle zu Ehren der Heiligen Familie. 1957 durch Herrn Josef Soiron als Dank für die Genesung seiner Tochter errichtet. Im Laufe der Zeit verfallen. Im Jahr 2014 vollständig renoviert.</value></Data><Data name="description:en"><value>The chapel in honor of the Holy Family was built in 1957 by Mr. Josef Soiron in gratitude for the recovery of his daughter. Over time, the chapel deteriorated visibly and the environment was turning into a wilderness. In 2014, it was completely renovated.</value></Data><Data name="description:fr"><value>Chapelle en l'honneur de la Sainte Famille construite 1957 par M. Josef Soiron en reconnaissance du rétablissement de sa fille. Au fil du temps, la chapelle s'est détériorée. En 2014,entièrement rénovée.</value></Data><Data name="description:nl"><value>Kapel ter ere van de Heilige Familie in 1957 gebouwd door de heer Josef Soiron in dankbaarheid voor het herstel van zijn dochter. In de loop van de tijd rakte de kapel zichtbaar in verval. In 2014 is ze volledig gerenoveerd.</value></Data><Data name="historic"><value>yes</value></Data><Data name="image"><value>File:Kapelle_im_Bellmerin_(2).jpg</value></Data><Data name="inscription"><value>STIFTUNG JOS. SOIRON 1957</value></Data><Data name="material"><value>wood</value></Data><Data name="name"><value>Kapelle zur Heiligen Familie</value></Data><Data name="religion"><value>christian</value></Data><Data name="start_date"><value>1957</value></Data><Data name="wikimedia_commons"><value>Category:Kapelle_im_Bellmerin_(Eupen)</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>6.0504214,50.6197997</coordinates></Point></Placemark><Placemark><ExtendedData><Data name="@id"><value>way/542597377</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Data><Data name="religion"><value>christian</value></Data><Data name="source"><value>survey</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>4.8392762,50.2425511</coordinates></Point></Placemark><Placemark><ExtendedData><Data name="@id"><value>way/542624354</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>chapel</value></Data><Data name="religion"><value>christian</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>4.8427227,50.2399159</coordinates></Point></Placemark><Placemark><name>Église Saint-Albin</name><ExtendedData><Data name="@id"><value>way/542825468</value></Data><Data name="amenity"><value>place_of_worship</value></Data><Data name="building"><value>church</value></Data><Data name="denomination"><value>roman_catholic</value></Data><Data name="name"><value>Église Saint-Albin</value></Data><Data name="religion"><value>christian</value></Data><Data name="website"><value>https://www.egliseinfo.be/lieu/68/vlessart/saint-albin</value></Data><Data name="@geometry"><value>center</value></Data></ExtendedData><Point><coordinates>5.6490104,49.7957453</coordinates></Point></Placemark><Placemark><name>Kristus-Koningkapel</name><ExtendedData><Data name="@id"><value>way/542928234</value></Data><Data name="wi